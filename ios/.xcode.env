# This `.xcode.env` file is versioned and is used to source the environment
# used when running script phases inside Xcode.
# To customize your local environment, you can create an `.xcode.env.local`
# file that is not versioned.

# Homebrew / global npm often exports npm_config_prefix. Login shells then
# source nvm, which aborts with: nvm is not compatible with npm_config_prefix.
unset npm_config_prefix NPM_CONFIG_PREFIX

# Prefer an absolute NODE_BINARY in `.xcode.env.local` so script phases do not
# depend on interactive PATH / nvm shims.
export NODE_BINARY="${NODE_BINARY:-$(command -v node)}"
export SENTRY_DISABLE_AUTO_UPLOAD=true
export SENTRY_DISABLE_XCODE_DEBUG_UPLOAD=true
