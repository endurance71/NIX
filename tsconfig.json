{
  "extends": "expo/tsconfig.base",
  "compilerOptions": {
    "strict": true,
    "skipLibCheck": true,
    "baseUrl": ".",
    "ignoreDeprecations": "6.0",
    "paths": {
      "@/*": [
        "src/*"
      ]
    }
  },
  "include": [
    "**/*.ts",
    "**/*.tsx",
    ".expo/types/**/*.ts",
    "expo-env.d.ts"
  ],
  "exclude": [
    "supabase/functions/**/*",
    "workers/**/*",
    "scripts/moderation-provider-spike.ts",
    "scripts/moderation-spike-lib.ts",
    "scripts/moderation-spike-lib_test.ts",
    "scripts/moderation-spike-retry_test.ts"
  ]
}
