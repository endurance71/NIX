Options -Indexes

<IfModule mod_headers.c>
  <IfModule mod_setenvif.c>
    SetEnvIf Request_URI "^/(privacy/|terms/|support/|invite/|nix-invite\.html$|legal\.css$|\.well-known/apple-app-site-association$)" NIX_PUBLIC_PATH
    Header always set Referrer-Policy "no-referrer" env=NIX_PUBLIC_PATH
    Header always set X-Content-Type-Options "nosniff" env=NIX_PUBLIC_PATH
    Header always set Permissions-Policy "camera=(), microphone=(), geolocation=()" env=NIX_PUBLIC_PATH
    Header always set Content-Security-Policy "default-src 'self'; base-uri 'none'; form-action 'none'; frame-ancestors 'none'; object-src 'none'; style-src 'self' 'unsafe-inline'; script-src 'self' 'unsafe-inline'" env=NIX_PUBLIC_PATH
  </IfModule>
</IfModule>

<Files "apple-app-site-association">
  ForceType application/json
  <IfModule mod_headers.c>
    Header set Cache-Control "public, max-age=3600"
  </IfModule>
</Files>

<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteRule ^invite/[^/]+/?$ /nix-invite.html [END]
</IfModule>

# LiteSpeed/hosting access logs must additionally exclude /invite/* in the
# hosting panel. Per-directory rewrite rules cannot guarantee log redaction.
