{
  "name": "nix",
  "version": "1.0.12",
  "engines": {
    "node": "24.x"
  },
  "main": "expo-router/entry",
  "scripts": {
    "start": "expo start",
    "ios": "expo run:ios",
    "lint": "expo lint",
    "test": "vitest run",
    "typecheck": "node scripts/generate-router-types.mjs && tsc --noEmit",
    "check-knip": "knip --exclude exports,types,enumMembers,nsExports,nsTypes,namespaceMembers,duplicates --no-config-hints",
    "expo-doctor": "npx -y expo-doctor@1.20.4",
    "expo-install-check": "expo install --check",
    "export:production": "SENTRY_DISABLE_AUTO_UPLOAD=true SENTRY_DISABLE_XCODE_DEBUG_UPLOAD=true expo export --platform ios --output-dir dist",
    "check:ios-config": "node scripts/check-ios-config.mjs",
    "check:invite-hosting": "node scripts/check-invite-hosting.mjs",
    "check:text-outbox-security": "node scripts/check-text-outbox-security.mjs",
    "check:sentry-disabled": "node scripts/check-sentry-disabled.mjs",
    "check:supabase-migrations": "node scripts/check-supabase-migrations.mjs",
    "check:supabase-db-lint": "node scripts/check-supabase-db-lint.mjs",
    "check:cleanup-nix-contract": "node scripts/check-cleanup-nix-contract.mjs",
    "check:report-content-contract": "node scripts/check-report-content-contract.mjs",
    "check:media-storage-integrity": "node scripts/check-media-storage-integrity.mjs",
    "check:moderation-evidence-integrity": "node scripts/check-moderation-evidence-integrity.mjs",
    "check:moderation-spike-evidence": "node scripts/check-moderation-spike-evidence.mjs",
    "deno:check:moderation-spike": "DENO_NO_PACKAGE_JSON=1 npx -y deno@2.9.6 check --no-config --min-dep-age=0 --lock=deno.lock scripts/moderation-provider-spike.ts scripts/moderation-spike-lib.ts",
    "deno:test:moderation-spike": "DENO_NO_PACKAGE_JSON=1 npx -y deno@2.9.6 test --no-config --min-dep-age=0 --lock=deno.lock scripts/moderation-spike-lib_test.ts scripts/moderation-spike-retry_test.ts supabase/functions/_shared/moderation-video-sampling_test.ts supabase/functions/_shared/moderation-video-scenes_test.ts",
    "test:supabase-db": "node scripts/run-supabase-tests.mjs",
    "check:internal-testflight-config": "node scripts/check-internal-testflight-config.mjs",
    "check:release-env": "node scripts/validate-release-env.mjs --mode production",
    "test:release-env": "node --test scripts/validate-release-env.test.mjs plugins/withIosReleaseEnvValidation.test.cjs",
    "sync:ios-release-env-validation": "node scripts/sync-ios-release-env-validation.cjs",
    "deno:check": "DENO_NO_PACKAGE_JSON=1 npx -y deno@2.9.6 check --frozen-lockfile --min-dep-age=0 --lock=deno.lock supabase/functions/_shared/http.ts supabase/functions/_shared/service-auth.ts supabase/functions/_shared/push.ts supabase/functions/_shared/data-export.ts supabase/functions/_shared/moderation-policy.ts supabase/functions/_shared/moderation-video-sampling.ts supabase/functions/_shared/moderation-video-scenes.ts supabase/functions/begin-media-upload/index.ts supabase/functions/finalize-media-upload/index.ts supabase/functions/cancel-media-upload/index.ts supabase/functions/cleanup-media-upload-orphans/index.ts supabase/functions/cleanup-nix/index.ts supabase/functions/cleanup-nix-due/index.ts supabase/functions/delete-account/index.ts supabase/functions/delete-account/handler.ts supabase/functions/delete-account/apple.ts supabase/functions/delete-account/identity.ts supabase/functions/delete-account/storage.ts supabase/functions/report-content/index.ts supabase/functions/report-content/contract.ts supabase/functions/block-user/index.ts supabase/functions/moderation-admin/index.ts supabase/functions/moderation-admin/contract.ts supabase/functions/cleanup-moderation-evidence/index.ts supabase/functions/cleanup-moderation-evidence/contract.ts supabase/functions/push-dispatch/index.ts supabase/functions/push-receipts/index.ts supabase/functions/data-export-download/index.ts supabase/functions/process-data-exports/index.ts scripts/moderation-provider-spike.ts",
    "deno:test": "DENO_NO_PACKAGE_JSON=1 npx -y deno@2.9.6 test --frozen-lockfile --min-dep-age=0 --lock=deno.lock --ignore='**/*.test.ts' supabase/functions scripts/moderation-spike-lib_test.ts scripts/moderation-spike-retry_test.ts",
    "spike:moderation-provider": "DENO_NO_PACKAGE_JSON=1 npx -y deno@2.9.6 run --no-config --min-dep-age=0 --lock=deno.lock --allow-net --allow-read --allow-write --allow-env --allow-run scripts/moderation-provider-spike.ts",
    "spike:moderation-fixtures": "bash scripts/generate-moderation-spike-fixtures.sh",
    "doctor:react": "react-doctor . --verbose",
    "doctor:react:ci": "react-doctor . --blocking warning --no-color --no-telemetry",
    "doctor:react:score": "react-doctor . --score",
    "doctor:react:changed": "react-doctor . --scope changed --base origin/main --include-untracked --blocking warning --no-color --no-telemetry",
    "postinstall": "patch-package",
    "check:toolchain": "node scripts/check-toolchain.mjs",
    "test:moderation-worker": "DENO_NO_PACKAGE_JSON=1 npx -y deno@2.9.6 test --no-config --frozen-lockfile --lock=deno.lock --min-dep-age=0 --allow-read --allow-write --allow-run workers/moderation",
    "audit:high": "npm audit --audit-level=high",
    "test:c3b-budget-concurrency": "node scripts/c3b-f0-budget-concurrency.mjs",
    "test:c3b-budget-concurrency-validate": "node --test scripts/c3b-f0-budget-concurrency-validate.test.mjs scripts/safe-psql-env.test.mjs scripts/c3b-isolated-guards.test.mjs scripts/c3b-isolated-migration-verify.test.mjs scripts/c3b-auth-storage-verify.test.mjs scripts/media-storage-trust-check.test.mjs scripts/local-type-database.test.mjs",
    "test:c3b-isolated-migrations": "node scripts/c3b-isolated-migration-verify.mjs",
    "test:c3b-auth-storage": "node scripts/c3b-auth-storage-verify.mjs",
    "test:c3b-auth-storage-b": "C3B_AUTHSTORE_PATH=B node scripts/c3b-auth-storage-verify.mjs",
    "audit:reviewed": "node scripts/audit-reviewed.mjs",
    "test:dependency-compat": "node --test scripts/query-string-compat.test.mjs",
    "gen:database": "node scripts/generate-database-types.mjs"
  },
  "dependencies": {
    "@expo/ui": "~57.0.22",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@react-native-community/netinfo": "12.0.1",
    "@sentry/react-native": "~7.11.0",
    "@shopify/flash-list": "2.0.2",
    "@shopify/react-native-skia": "2.6.2",
    "@supabase/supabase-js": "2.117.3",
    "@tanstack/react-query": "^5.104.1",
    "expo": "~57.0.27",
    "expo-apple-authentication": "~57.0.2",
    "expo-asset": "~57.0.19",
    "expo-audio": "~57.0.5",
    "expo-background-task": "~57.0.21",
    "expo-blur": "~57.0.3",
    "expo-build-properties": "~57.0.22",
    "expo-camera": "~57.0.6",
    "expo-constants": "~57.0.21",
    "expo-crypto": "~57.0.3",
    "expo-dev-client": "~57.0.19",
    "expo-file-system": "~57.0.7",
    "expo-font": "~57.0.4",
    "expo-glass-effect": "~57.0.4",
    "expo-haptics": "~57.0.3",
    "expo-image": "~57.0.5",
    "expo-image-manipulator": "~57.0.21",
    "expo-image-picker": "~57.0.20",
    "expo-linear-gradient": "~57.0.2",
    "expo-linking": "~57.0.12",
    "expo-localization": "~57.0.2",
    "expo-media-library": "~57.0.5",
    "expo-notifications": "~57.0.22",
    "expo-paste-input": "0.2.2",
    "expo-router": "~57.0.25",
    "expo-screen-capture": "~57.0.4",
    "expo-secure-store": "~57.0.4",
    "expo-splash-screen": "~57.0.9",
    "expo-sqlite": "~57.0.4",
    "expo-status-bar": "~57.0.1",
    "expo-store-review": "~57.0.3",
    "expo-symbols": "~57.0.3",
    "expo-task-manager": "~57.0.21",
    "expo-updates": "~57.0.25",
    "expo-video": "~57.0.5",
    "expo-widgets": "~57.0.23",
    "graphemer": "^1.4.0",
    "i18next": "^26.4.2",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-i18next": "^17.0.16",
    "react-native": "0.86.3",
    "react-native-compressor": "^1.19.4",
    "react-native-gesture-handler": "~2.32.0",
    "react-native-image-crop-picker": "^0.51.1",
    "react-native-qrcode-svg": "^6.3.26",
    "react-native-reanimated": "4.5.1",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.26.0",
    "react-native-svg": "15.15.4",
    "react-native-url-polyfill": "^3.0.0",
    "react-native-worklets": "0.10.1",
    "tus-js-client": "^4.3.1"
  },
  "devDependencies": {
    "@expo/env": "2.4.3",
    "@types/react": "~19.2.18",
    "eslint": "^9.39.5",
    "eslint-config-expo": "~57.0.2",
    "expo-mcp": "^0.2.4",
    "knip": "^6.40.0",
    "patch-package": "^8.0.1",
    "react-doctor": "^0.9.17",
    "sf-symbols-typescript": "^2.2.0",
    "typescript": "~6.0.3",
    "vitest": "^4.1.11",
    "xcode": "3.0.1",
    "query-string": "7.1.3"
  },
  "private": true,
  "overrides": {
    "js-yaml": "4.3.2",
    "nanoid": "3.3.18",
    "uuid": "^11.1.1",
    "brace-expansion@^1.0.0": "1.1.21",
    "brace-expansion@^1.1.7": "1.1.21",
    "brace-expansion@^5.0.0": "5.0.12",
    "query-string": {
      "decode-uri-component": "0.5.0"
    },
    "proxy-addr": "2.0.8",
    "shell-quote": "1.12.0",
    "compression": "1.8.2",
    "fast-uri@^3.0.1": "3.1.8",
    "source-map-js": "1.2.2",
    "@modelcontextprotocol/sdk": "1.32.1",
    "hono": "4.13.13",
    "ip-address": "10.7.3",
    "smol-toml": "1.9.0"
  },
  "patch-package": {
    "ignorePaths": [
      "**/.DS_Store"
    ]
  },
  "allowScripts": {
    "@sentry/cli@2.58.4": true,
    "fsevents@2.3.3": true,
    "unrs-resolver@1.12.2": true,
    "@shopify/react-native-skia@2.6.2": true
  },
  "expo": {
    "autolinking": {
      "ios": {
        "buildFromSource": [
          "expo-camera",
          "expo-image-manipulator",
          "expo-screen-capture",
          "expo-video"
        ]
      }
    },
    "doctor": {
      "appConfigFieldsNotSyncedCheck": {
        "enabled": false
      },
      "reactNativeDirectoryCheck": {
        "exclude": [
          "react-native-compressor",
          "expo-paste-input"
        ]
      }
    }
  }
}
