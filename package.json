{
  "name": "nix",
  "version": "1.0.11",
  "engines": {
    "node": "24.x"
  },
  "main": "expo-router/entry",
  "scripts": {
    "start": "expo start",
    "ios": "expo run:ios",
    "lint": "expo lint",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "check-knip": "knip --exclude exports,types,enumMembers,nsExports,nsTypes,namespaceMembers,duplicates --no-config-hints",
    "expo-doctor": "npx -y expo-doctor@latest",
    "expo-install-check": "expo install --check",
    "export:production": "SENTRY_DISABLE_AUTO_UPLOAD=true SENTRY_DISABLE_XCODE_DEBUG_UPLOAD=true expo export --platform ios --output-dir dist",
    "check:ios-config": "node scripts/check-ios-config.mjs",
    "check:invite-hosting": "node scripts/check-invite-hosting.mjs",
    "check:text-outbox-security": "node scripts/check-text-outbox-security.mjs",
    "check:sentry-disabled": "node scripts/check-sentry-disabled.mjs",
    "check:supabase-migrations": "node scripts/check-supabase-migrations.mjs",
    "check:supabase-db-lint": "node scripts/check-supabase-db-lint.mjs",
    "check:cleanup-nix-contract": "node scripts/check-cleanup-nix-contract.mjs",
    "check:report-content-contract": "node scripts/check-report-content-contract.mjs",
    "check:media-storage-integrity": "node scripts/check-media-storage-integrity.mjs",
    "check:moderation-evidence-integrity": "node scripts/check-moderation-evidence-integrity.mjs",
    "test:supabase-db": "node scripts/run-supabase-tests.mjs",
    "check:internal-testflight-config": "node scripts/check-internal-testflight-config.mjs",
    "deno:check": "npx -y deno check --min-dep-age=0 --lock=deno.lock supabase/functions/_shared/http.ts supabase/functions/_shared/service-auth.ts supabase/functions/_shared/push.ts supabase/functions/_shared/data-export.ts supabase/functions/begin-media-upload/index.ts supabase/functions/finalize-media-upload/index.ts supabase/functions/cancel-media-upload/index.ts supabase/functions/cleanup-media-upload-orphans/index.ts supabase/functions/cleanup-nix/index.ts supabase/functions/cleanup-nix-due/index.ts supabase/functions/delete-account/index.ts supabase/functions/delete-account/handler.ts supabase/functions/delete-account/apple.ts supabase/functions/delete-account/identity.ts supabase/functions/delete-account/storage.ts supabase/functions/report-content/index.ts supabase/functions/report-content/contract.ts supabase/functions/block-user/index.ts supabase/functions/moderation-admin/index.ts supabase/functions/moderation-admin/contract.ts supabase/functions/cleanup-moderation-evidence/index.ts supabase/functions/cleanup-moderation-evidence/contract.ts supabase/functions/push-dispatch/index.ts supabase/functions/push-receipts/index.ts supabase/functions/data-export-download/index.ts supabase/functions/process-data-exports/index.ts",
    "deno:test": "npx -y deno test --min-dep-age=0 --lock=deno.lock supabase/functions/_shared/http_test.ts supabase/functions/_shared/service-auth_test.ts supabase/functions/_shared/push_preferences_test.ts supabase/functions/_shared/data-export_test.ts supabase/functions/report-content/contract_test.ts supabase/functions/cleanup-moderation-evidence/contract_test.ts supabase/functions/moderation-admin/contract_test.ts supabase/functions/delete-account/identity_test.ts supabase/functions/delete-account/apple_test.ts supabase/functions/delete-account/handler_test.ts supabase/functions/delete-account/storage_test.ts",
    "doctor:react": "react-doctor . --verbose",
    "doctor:react:ci": "echo \"Skipping React Doctor in CI temporarily\"",
    "doctor:react:score": "react-doctor . --score",
    "doctor:react:changed": "echo \"Skipping React Doctor in CI temporarily\"",
    "postinstall": "patch-package"
  },
  "dependencies": {
    "@expo/ui": "~57.0.13",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@react-native-community/netinfo": "12.0.1",
    "@sentry/react-native": "~7.11.0",
    "@shopify/flash-list": "2.0.2",
    "@supabase/supabase-js": "^2.112.4",
    "@tanstack/react-query": "^5.102.3",
    "expo": "~57.0.16",
    "expo-apple-authentication": "~57.0.1",
    "expo-asset": "~57.0.13",
    "expo-audio": "~57.0.4",
    "expo-background-task": "~57.0.13",
    "expo-blur": "~57.0.2",
    "expo-build-properties": "~57.0.14",
    "expo-camera": "~57.0.4",
    "expo-constants": "~57.0.13",
    "expo-crypto": "~57.0.2",
    "expo-dev-client": "~57.0.15",
    "expo-file-system": "~57.0.5",
    "expo-font": "~57.0.1",
    "expo-glass-effect": "~57.0.1",
    "expo-haptics": "~57.0.1",
    "expo-image": "~57.0.3",
    "expo-image-manipulator": "~57.0.13",
    "expo-image-picker": "~57.0.13",
    "expo-linear-gradient": "~57.0.1",
    "expo-linking": "~57.0.7",
    "expo-localization": "~57.0.1",
    "expo-media-library": "~57.0.4",
    "expo-notifications": "~57.0.14",
    "expo-paste-input": "0.2.2",
    "expo-router": "~57.0.16",
    "expo-screen-capture": "57.0.2",
    "expo-secure-store": "~57.0.1",
    "expo-splash-screen": "~57.0.8",
    "expo-sqlite": "~57.0.1",
    "expo-status-bar": "~57.0.1",
    "expo-store-review": "~57.0.2",
    "expo-symbols": "~57.0.2",
    "expo-task-manager": "~57.0.13",
    "expo-updates": "~57.0.17",
    "expo-video": "~57.0.2",
    "expo-widgets": "~57.0.11",
    "graphemer": "^1.4.0",
    "i18next": "^26.4.0",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-i18next": "^17.0.12",
    "react-native": "0.86.2",
    "react-native-compressor": "^1.19.4",
    "react-native-gesture-handler": "~2.32.0",
    "react-native-image-crop-picker": "^0.51.1",
    "react-native-pretty-toast": "^1.0.2",
    "react-native-qrcode-svg": "^6.3.21",
    "react-native-reanimated": "4.5.1",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.26.0",
    "react-native-svg": "15.15.4",
    "react-native-url-polyfill": "^3.0.0",
    "react-native-worklets": "0.10.1",
    "tus-js-client": "^4.3.1"
  },
  "devDependencies": {
    "@types/react": "~19.2.18",
    "eslint": "^9.39.5",
    "eslint-config-expo": "~57.0.1",
    "expo-mcp": "^0.2.4",
    "knip": "^6.32.2",
    "patch-package": "^8.0.1",
    "react-doctor": "^0.9.12",
    "sf-symbols-typescript": "^2.2.0",
    "typescript": "~6.0.3",
    "vitest": "^4.1.11"
  },
  "private": true,
  "overrides": {
    "glob": {
      "brace-expansion": "5.0.9"
    },
    "js-yaml": "4.3.1",
    "nanoid": "3.3.18",
    "uuid": "^11.1.1"
  },
  "patch-package": {
    "ignorePaths": [
      "**/.DS_Store"
    ]
  },
  "allowScripts": {
    "@sentry/cli@2.58.4": true,
    "fsevents@2.3.3": true,
    "unrs-resolver@1.12.2": true
  },
  "expo": {
    "autolinking": {
      "ios": {
        "buildFromSource": [
          "expo-camera",
          "expo-image-manipulator",
          "expo-screen-capture",
          "expo-video"
        ]
      }
    },
    "install": {
      "exclude": [
        "@expo/ui",
        "eslint-config-expo",
        "expo",
        "expo-asset",
        "expo-background-task",
        "expo-build-properties",
        "expo-constants",
        "expo-dev-client",
        "expo-file-system",
        "expo-haptics",
        "expo-image-manipulator",
        "expo-image-picker",
        "expo-linking",
        "expo-notifications",
        "expo-router",
        "expo-secure-store",
        "expo-sqlite",
        "expo-task-manager",
        "expo-updates",
        "expo-video",
        "expo-widgets",
        "react-native"
      ]
    },
    "doctor": {
      "appConfigFieldsNotSyncedCheck": {
        "enabled": false
      },
      "reactNativeDirectoryCheck": {
        "exclude": [
          "react-native-compressor",
          "expo-paste-input"
        ]
      }
    }
  }
}
