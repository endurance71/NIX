index 5f34eb2..c91c259 100644
--- a/node_modules/expo-widgets/ios/LiveActivity.swift
+++ b/node_modules/expo-widgets/ios/LiveActivity.swift
@@ -1,6 +1,73 @@
 import ExpoModulesCore
 import ActivityKit
 
+@available(iOS 16.2, *)
+public enum ExpoWidgetsLiveActivityBridge {
+  /// Only activities that can still be shown and updated. `Activity.activities` keeps ended
+  /// (still on the Lock Screen until dismissal) and dismissed activities around for a while;
+  /// updating those is a silent no-op, so treating them as "running" would make the native
+  /// fallback skip `Activity.request` and the upload would never get a Live Activity.
+  private static func liveActivities(named name: String) -> [Activity<LiveActivityAttributes>] {
+    Activity<LiveActivityAttributes>.activities.filter { activity in
+      let state = activity.activityState
+      return (state == .active || state == .stale) && activity.content.state.name == name
+    }
+  }
+
+  public static func status(name: String) -> [String: Any] {
+    [
+      "enabled": ActivityAuthorizationInfo().areActivitiesEnabled,
+      "activeCount": liveActivities(named: name).count
+    ]
+  }
+
+  public static func startOrUpdate(name: String, props: String, url: URL?) async {
+    let state = LiveActivityAttributes.ContentState(name: name, props: props)
+    let content = ActivityContent(state: state, staleDate: nil)
+    let activities = liveActivities(named: name)
+    if !activities.isEmpty {
+      for activity in activities {
+        await activity.update(content)
+      }
+      return
+    }
+
+    guard ActivityAuthorizationInfo().areActivitiesEnabled else {
+      print("[ExpoWidgets] Live Activities are disabled for \(name)")
+      return
+    }
+
+    do {
+      // The widget reads the deep link from the static attributes (same as LiveActivityFactory).
+      _ = try Activity.request(
+        attributes: LiveActivityAttributes(url: url?.absoluteString),
+        content: content,
+        pushType: nil
+      )
+      print("[ExpoWidgets] Started Live Activity \(name)")
+    } catch {
+      print("[ExpoWidgets] Could not start Live Activity \(name): \(error.localizedDescription)")
+    }
+  }
+
+  public static func update(name: String, props: String) async {
+    let state = LiveActivityAttributes.ContentState(name: name, props: props)
+    let content = ActivityContent(state: state, staleDate: nil)
+    for activity in liveActivities(named: name) {
+      await activity.update(content)
+    }
+  }
+
+  public static func end(name: String, props: String, after date: Date) async {
+    let state = LiveActivityAttributes.ContentState(name: name, props: props)
+    let content = ActivityContent(state: state, staleDate: nil)
+    // Already ended activities keep their own dismissal schedule.
+    for activity in liveActivities(named: name) {
+      await activity.end(content, dismissalPolicy: .after(date))
+    }
+  }
+}
+
 final class LiveActivity: SharedObject {
   let id: String
   let name: String
