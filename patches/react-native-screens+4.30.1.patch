+// NiX patch (NOTIF-6): host the overlay container in its own pass-through UIWindow.
+// Upstream adds the container as a subview of the key window once, so any UIKit presentation
+// shown later (formSheet, image picker, share sheet, UIAlertController) is placed above it and
+// hides in-app banners. The container now lives in a dedicated window in the same UIWindowScene at
+// `UIWindowLevelAlert + 1`: transparent, never key (keyboard focus and first responder stay in
+// the app window), touches outside the overlay's React subviews fall through to the windows below,
+// status bar / orientation queries are forwarded to the app window, and the window is hidden and
+// released when the overlay unmounts or is recycled. Without a window scene (should not happen on
+// iOS 13+) it falls back to the upstream behaviour.
+
+@interface RNSFullWindowOverlayWindow : UIWindow
+@end
+
+@implementation RNSFullWindowOverlayWindow
+
+- (BOOL)canBecomeKeyWindow
+{
+  return NO;
+}
+
+- (UIView *)hitTest:(CGPoint)point withEvent:(UIEvent *)event
+{
+  UIView *hitView = [super hitTest:point withEvent:event];
+  // Nothing of the overlay content was hit: return nil so UIKit delivers the touch to the
+  // next window below (the app window, a presented sheet, ...).
+  if (hitView == self || hitView == self.rootViewController.view) {
+    return nil;
+  }
+  return hitView;
+}
+
+@end
+
+@interface RNSFullWindowOverlayViewController : UIViewController
+@property (nonatomic, weak) UIWindow *hostWindow;
+@end
+
+@implementation RNSFullWindowOverlayViewController
+
+- (void)loadView
+{
+  UIView *view = [UIView new];
+  view.backgroundColor = UIColor.clearColor;
+  self.view = view;
+}
+
+- (UIViewController *)hostTopViewController
+{
+  UIViewController *controller = self.hostWindow.rootViewController;
+  while (controller.presentedViewController != nil && !controller.presentedViewController.isBeingDismissed) {
+    controller = controller.presentedViewController;
+  }
+  return controller;
+}
+
+- (UIViewController *)hostStatusBarStyleViewController
+{
+  UIViewController *controller = [self hostTopViewController];
+  while (controller.childViewControllerForStatusBarStyle != nil) {
+    controller = controller.childViewControllerForStatusBarStyle;
+  }
+  return controller;
+}
+
+- (UIViewController *)hostStatusBarHiddenViewController
+{
+  UIViewController *controller = [self hostTopViewController];
+  while (controller.childViewControllerForStatusBarHidden != nil) {
+    controller = controller.childViewControllerForStatusBarHidden;
+  }
+  return controller;
+}
+
+- (UIStatusBarStyle)preferredStatusBarStyle
+{
+  UIViewController *controller = [self hostStatusBarStyleViewController];
+  return controller != nil ? controller.preferredStatusBarStyle : [super preferredStatusBarStyle];
+}
+
+- (BOOL)prefersStatusBarHidden
+{
+  UIViewController *controller = [self hostStatusBarHiddenViewController];
+  return controller != nil ? controller.prefersStatusBarHidden : [super prefersStatusBarHidden];
+}
+
+- (UIInterfaceOrientationMask)supportedInterfaceOrientations
+{
+  UIViewController *controller = [self hostTopViewController];
+  return controller != nil ? controller.supportedInterfaceOrientations : [super supportedInterfaceOrientations];
+}
+
+@end
+
