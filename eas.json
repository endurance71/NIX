{
  "cli": {
    "version": ">= 16.0.1",
    "appVersionSource": "local"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal",
      "env": {
        "SENTRY_DISABLE_AUTO_UPLOAD": "true",
        "SENTRY_DISABLE_XCODE_DEBUG_UPLOAD": "true"
      },
      "channel": "development"
    },
    "preview": {
      "distribution": "internal",
      "env": {
        "SENTRY_DISABLE_AUTO_UPLOAD": "true",
        "SENTRY_DISABLE_XCODE_DEBUG_UPLOAD": "true"
      },
      "ios": {
        "resourceClass": "m-medium"
      },
      "channel": "preview"
    },
    "production": {
      "autoIncrement": false,
      "environment": "production",
      "env": {
        "EXPO_PUBLIC_BACKGROUND_UPLOAD_ENABLED": "true",
        "EXPO_PUBLIC_DURABLE_UPLOAD_QUEUE_ENABLED": "true",
        "EXPO_PUBLIC_HEVC_CAPTURE_ENABLED": "false",
        "EXPO_PUBLIC_SHARED_MEDIA_ASSETS_ENABLED": "true",
        "EXPO_PUBLIC_UPLOAD_LIVE_ACTIVITY_ENABLED": "true",
        "EXPO_PUBLIC_PRODUCT_ANALYTICS_ENABLED": "false",
        "EXPO_PUBLIC_SENTRY_ENABLED": "false",
        "SENTRY_DISABLE_AUTO_UPLOAD": "true",
        "SENTRY_DISABLE_XCODE_DEBUG_UPLOAD": "true"
      },
      "ios": {
        "resourceClass": "m-medium"
      },
      "channel": "production"
    }
  },
  "submit": {
    "production": {
      "ios": {
        "ascAppId": "6791332379"
      }
    }
  }
}
